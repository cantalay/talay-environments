{
  "title": "VitaFinder",
  "uid": "vitafinder",
  "tags": [
    "talay",
    "vitafinder"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "vitafinder-api",
        "hide": 2
      },
      {
        "name": "service",
        "type": "constant",
        "query": "vitafinder-api",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "İstek/sn",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx oranı",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 süre",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Restart (24s)",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[24h]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "İstek/sn — route ve durum",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_request_method}} {{http_route}} {{http_response_status_code}}",
          "expr": "sum by (http_request_method, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gecikme p50 / p95 / p99",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU (cores)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\"}[5m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bellek (working set)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"})"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Hata logları",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"$namespace\"} |~ \"(?i)(\\\"level\\\":(50|60)|\\\"level\\\":\\\"(error|fatal)\\\"|ERROR|Exception)\""
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Son trace'ler",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" }",
          "limit": 20
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Veri toplama ve fiyat zekâsı (worker)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Worker up",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"vitafinder-worker\"})"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Taranmayı bekleyen listing",
      "gridPos": {
        "x": 4,
        "y": 37,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vitafinder_listings_due{namespace=\"vitafinder-worker\"})"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Eşleştirme kuyruğu",
      "gridPos": {
        "x": 9,
        "y": 37,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vitafinder_match_review_queue_depth{namespace=\"vitafinder-worker\"})"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Bekleyen bildirim",
      "gridPos": {
        "x": 14,
        "y": 37,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vitafinder_notification_pending{namespace=\"vitafinder-worker\"})"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Fiyat değişimi / sa",
      "gridPos": {
        "x": 19,
        "y": 37,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vitafinder_price_events_total{namespace=\"vitafinder-worker\",kind=\"change\"}[1h]))"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Sağlayıcı istekleri (durum kodu)",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, status) (rate(vitafinder_provider_requests_total{namespace=\"vitafinder-worker\"}[10m]))",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Veri tazeliği (son başarıdan beri)",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (vitafinder_provider_freshness_seconds{namespace=\"vitafinder-worker\"})",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Fetch süresi p95",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(vitafinder_provider_fetch_duration_seconds_bucket{namespace=\"vitafinder-worker\"}[15m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Parse hatası / sa",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(vitafinder_parser_failures_total{namespace=\"vitafinder-worker\"}[1h]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Fiyat olayları",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(vitafinder_price_events_total{namespace=\"vitafinder-worker\"}[15m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Ciddi fiyat oynamaları",
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, status) (increase(vitafinder_price_alerts_total{namespace=\"vitafinder-worker\"}[1h]))",
          "legendFormat": "{{kind}} {{status}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Bildirim teslimi",
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, status) (increase(vitafinder_notifications_total{namespace=\"vitafinder-worker\"}[1h]))",
          "legendFormat": "{{channel}} {{status}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Arka plan işleri (hata)",
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (increase(vitafinder_job_runs_total{namespace=\"vitafinder-worker\",status=\"failed\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Worker CPU / bellek",
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"vitafinder-worker\",container!=\"\"}[5m]))",
          "legendFormat": "CPU (core)"
        },
        {
          "refId": "B",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"vitafinder-worker\",container!=\"\"})/1e9",
          "legendFormat": "Bellek (GB)"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "API (uygulama metriği) p95 route",
      "gridPos": {
        "x": 12,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(vitafinder_http_request_duration_seconds_bucket{namespace=\"vitafinder-api\"}[10m])))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}