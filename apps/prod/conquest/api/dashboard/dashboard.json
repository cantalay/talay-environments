{
 "uid": "conquest",
 "title": "Colony Conquest",
 "tags": [
  "conquest",
  "talay"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "type": "constant",
    "query": "conquest-api",
    "hide": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{namespace=\"$namespace\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Hazır pod",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\"})"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "İstek/sn",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\"}[5m]))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "5xx oranı",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\"}[5m])),1e-9)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Oturum (24s)",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(conquest_sessions_total{namespace=\"$namespace\"}[24h]))"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Silinen hesap (7g)",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(conquest_accounts_deleted_total{namespace=\"$namespace\"}[7d]))"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "İstekler (rota)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\"}[5m]))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Gecikme p50/p95/p99 (WebSocket hariç)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",http_route!~\"/hubs.*\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",http_route!~\"/hubs.*\"}[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",http_route!~\"/hubs.*\"}[5m])))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Oyun etkinliği",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(conquest_sessions_total{namespace=\"$namespace\"}[5m]))*60",
     "legendFormat": "oturum/dk"
    },
    {
     "refId": "B",
     "expr": "sum(rate(conquest_matchmaking_joins_total{namespace=\"$namespace\"}[5m]))*60",
     "legendFormat": "eşleştirme/dk"
    },
    {
     "refId": "C",
     "expr": "sum by (outcome) (rate(conquest_commands_total{namespace=\"$namespace\"}[5m]))*60",
     "legendFormat": "komut {{outcome}}/dk"
    },
    {
     "refId": "D",
     "expr": "sum(rate(conquest_moves_batches_total{namespace=\"$namespace\"}[5m]))*60",
     "legendFormat": "hamle grubu/dk"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Durum kodları",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\"}[5m]))",
     "legendFormat": "{{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Bellek",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"})",
     "legendFormat": "working set"
    },
    {
     "refId": "B",
     "expr": "sum(dotnet_gc_last_collection_heap_size_bytes{namespace=\"$namespace\"})",
     "legendFormat": "GC heap"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "CPU",
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\"}[5m]))",
     "legendFormat": "cpu"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "cores"
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "GC ve iş parçacıkları",
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total{namespace=\"$namespace\"}[5m]))",
     "legendFormat": "gc {{gc_heap_generation}}/sn"
    },
    {
     "refId": "B",
     "expr": "sum(dotnet_thread_pool_thread_count{namespace=\"$namespace\"})",
     "legendFormat": "thread pool"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Orleans: etkin grain",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(orleans_grain{namespace=\"$namespace\"})",
     "legendFormat": "grain"
    },
    {
     "refId": "B",
     "expr": "sum(orleans_catalog_activations{namespace=\"$namespace\"})",
     "legendFormat": "activation"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Yeniden başlatma",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))",
     "legendFormat": "restart/saat"
    }
   ]
  }
 ]
}